PORT=3000

# Slack Socket Mode
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_COMPLETION_CHANNEL_ID=C000000000
SLACK_HOMEWORK_CHANNEL_ID=C000000000
HOMEWORK_REVIEW_BASE_URL=https://your-name.github.io/knowledge-workflows/homework-manga/
HOMEWORK_OWNER_UID=your-firebase-auth-uid
HOMEWORK_DRIVE_FOLDER_ID=your-homework-image-folder-id

# Google OAuth. This mode saves files to the authenticated user's Drive.
GOOGLE_AUTH_MODE=oauth
GOOGLE_DRIVE_FOLDER_ID=...
GOOGLE_SLIDES_TEMPLATE_ID=...
GAS_WEB_APP_URL=https://script.google.com/macros/s/.../exec

# リサーチモード（Web 検索でスライド生成する場合に使用）
TAVILY_API_KEY=tvly-your-tavily-api-key

# YouTube Data API。未設定でも字幕は取得できるが、設定すると動画メタデータも取得する。
# 共有抽出器の資格情報。bookmark-curator と共通のため、中立な
# %USERPROFILE%\.content-extractor\.env に置けば両アプリで共有される。
# ローカルで上書きする場合のみコメントを外して指定する(空のまま残さない)。
# YOUTUBE_API_KEY=your_youtube_api_key_here

# X(Twitter)投稿の本文取得。ログイン済み Playwright storageState の JSON パスを指定すると
# 有効化される。未設定の場合、X 投稿はテキスト取得できずフォールバックする。
#
# これは「あなたのログイン済み X セッション」= アプリ非依存のユーザー資格情報です。
# 特定リポジトリ配下ではなく、どのプロジェクトにも属さない中立な場所に置いてください。
# 未設定なら既定で %USERPROFILE%\.content-extractor\x-session.json を参照します。
# 別の場所に置く場合のみ、コメントを外して指定してください(空のまま残さない)。
# X_SESSION_STATE_PATH=C:\Users\<you>\.content-extractor\x-session.json
# X_HEADLESS=true

# Instapaper Full API (Kobo reader integration).
# Consumer credentials require Instapaper approval. Access tokens are obtained once with
# the interactive `npm run instapaper:token` command. Never store the account password here.
# INSTAPAPER_CONSUMER_KEY=
# INSTAPAPER_CONSUMER_SECRET=
# INSTAPAPER_ACCESS_TOKEN=
# INSTAPAPER_ACCESS_TOKEN_SECRET=
# スライド生成完了後、Kobo向け本文を自動送信する場合のみ true にする。
# INSTAPAPER_AUTO_SEND=false
# READER_BASE_URL=https://lomoxiao.github.io/multimodal-article-viewer/

# Claude Code — headless long-lived auth token.
# On Windows, the normal OAuth token expires after ~8 hours and does not auto-refresh in headless mode,
# causing `claude -p` and `claude --chrome` calls to fail with 401 errors.
# Fix: run `claude setup-token` interactively once (browser auth required), copy the displayed token here.
# IMPORTANT: use ANTHROPIC_AUTH_TOKEN — CLAUDE_CODE_OAUTH_TOKEN does NOT take priority over an active
# subscription login and silently does nothing.
ANTHROPIC_AUTH_TOKEN=

# Claude Code settings (NotebookLM autosync / manga generation via `claude` CLI).
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=opus
CLAUDE_EXEC_TIMEOUT_MS=900000

# NotebookLM deck URL retrieval. Generation still waits 10 minutes before the first check.
MANGA_DECK_FETCH_MAX_TURNS=20
MANGA_DECK_FETCH_TIMEOUT_MS=240000

# Local Codex automation. This does not call metered LLM APIs from Node.js.
AUTO_RUN_CODEX=true
# Windowsでは絶対パスを必ず設定してください。WindowsApps配下のパスは使用不可。
# CODEX_CLI_COMMAND=C:\Users\<YourName>\AppData\Local\OpenAI\Codex\bin\codex.exe
CODEX_CLI_COMMAND=codex
# 候補を順に試し、model_not_found の場合だけ次へ切り替える
CODEX_MODEL_CANDIDATES=gpt-6.1-sol,gpt-6-luna
# 固定は CODEX_MODEL=<モデル名>、CLI への委任は CODEX_MODEL=auto
CODEX_RUNNER_HOME=./.codex-runner-home
# Optional. Defaults to %USERPROFILE%\.codex on Windows.
CODEX_SOURCE_HOME=
CODEX_EXEC_SANDBOX=workspace-write
CODEX_EXEC_TIMEOUT_MS=900000

# Optional service account mode.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# Summary provider. Default avoids metered LLM APIs.
SUMMARY_PROVIDER=codex_job

# Local article explainer video (disabled until Phase 0/E2E completes)
VIDEO_GENERATION_ENABLED=false
VIDEO_RICH_MOTION_ENABLED=false
VIDEO_DRIVE_FOLDER_ID=
VIDEO_TTS_PYTHON=.venv-video/Scripts/python.exe
VIDEO_TTS_VOICE=jf_alpha
VIDEO_TTS_SPEED=1.0
VIDEO_JOB_TIMEOUT_MS=2700000
VIDEO_MAX_FILE_BYTES=500000000

# 記事取得時の名乗り(User-Agent)とタイムアウト。未設定なら Chrome の名乗り・30秒。
WEB_HTTP_USER_AGENT=
WEB_HTTP_TIMEOUT_MS=30000

# 1日のまとめ(今日のまとめ)。DIGEST_SOURCE_DIR は news-dashboard の .runtime/digest の絶対パス。
DIGEST_ENABLED=false
DIGEST_SOURCE_DIR=
DIGEST_ALERT_HOUR_JST=9

# 保存済み本文を再利用する期間(時間)。0 は期限なし(一度取れたら使い続ける)。
INGEST_REUSE_HOURS=24

# 束(複数記事のまとめ)に入れられる記事数の上限
BUNDLE_MAX_MEMBERS=10

# 受信箱(保存しただけの記事)に3行要約を付ける。true で有効。
INBOX_SUMMARY_ENABLED=false
# 確認の間隔(分)と、1回に処理する件数
INBOX_SUMMARY_INTERVAL_MIN=10
INBOX_SUMMARY_MAX_PER_TICK=3

# 読み上げの合成方法: kokoro(既定・PC 内で完結) / gemini(Gemini API。API キーが必要で、従量課金になり得る)
# 詳しくは docs/gemini-tts-notes.md
TTS_PROVIDER=kokoro
# Gemini API のキー。実値はコミットしない
GEMINI_API_KEY=
# gemini-3.8-flash-lite-tts(既定・速い・安い) / gemini-3.8-flash-tts(品質重視)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# 話し方の指示(英語推奨)
GEMINI_TTS_STYLE=calm, clear and natural, like a Japanese news briefing
# audio = 1日のまとめ・束などの音声だけ / all = 動画のナレーションも
GEMINI_TTS_SCOPE=audio
# 1日(JST)に Gemini へ送る文字数の上限。超えたら Kokoro で作る
GEMINI_TTS_MAX_CHARS_PER_DAY=20000
GEMINI_TTS_TIMEOUT_MS=120000

# 深掘りリサーチ: 確かめる出典の最大数・1日の上限・1件の時間の上限(分)
RESEARCH_MAX_SOURCES=12
RESEARCH_MAX_PER_DAY=10
RESEARCH_TIMEOUT_MIN=20
